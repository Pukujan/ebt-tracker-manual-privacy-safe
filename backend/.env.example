# Copy to .env and fill in values. See docs/STARTER_PACK.md.

PORT=3001

# Neon (Postgres) — connection string from Neon dashboard
POSTGRES_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# OpenRouter — API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter OpenAI-compatible API base (default)
LLM_BASE_URL=https://openrouter.ai/api/v1
